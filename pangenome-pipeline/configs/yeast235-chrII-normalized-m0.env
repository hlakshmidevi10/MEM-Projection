# =============================================================================
# Config: yeast-235 chrII 100kb normalized graph — gfa2gbwt -m 0 variant
# =============================================================================
# Companion to yeast235-chrII-normalized.env. This run uses a GBZ built WITHOUT
# segment splitting (gfa2gbwt -m 0), so GBZ node IDs equal the source GFA's
# segment IDs. The baseline _normalized.gbz was built with default -m 1024
# (split long segments into ≤1024-bp nodes); this variant preserves them
# (max ~193,040 bp). Exercises pangenome-index's handling of long nodes.
#
# Rename to yeast235-chrII-normalized-m0.env before invoking build_index.sh + query.sh:
#   mv yeast235-chrII-normalized-m0.env.example yeast235-chrII-normalized-m0.env
#
# Launch:
#   ./build_index.sh yeast235-chrII-normalized-m0.env yeast235-chrII-m0-<date>
# =============================================================================

# ---- Inputs ---------------------------------------------------------------
# Only $GBZ is an input. build_index.sh derives ${BASE}.gfa from $GBZ in step 01b via
# `vg convert -fW --no-translation`, guaranteeing the GFA gafpack walks shares
# node IDs with what find_mems sees.
#
# Build prereq (one-time):
#   cd $MEM_PROJ/yeast-235/yeast-235-chrI/final_output2
#   gfa2gbwt -c -p --pan-sn -m 0 -P 16 yeast235_chrII_100kb_laced_sorted_normalized
#   mv yeast235_chrII_100kb_laced_sorted_normalized.gbz \
#      yeast235_chrII_100kb_laced_sorted_normalized_m0.gbz
GBZ="$MEM_PROJ/yeast-235/yeast-235-chrI/final_output2/yeast235_chrII_100kb_laced_sorted_normalized_m0.gbz"

# Reads file: same as the baseline config — this is an index-side experiment.
READS="$MEM_PROJ/yeast-235/yeast-235-chrI/S288C_chrII_N100K_R1_200_reads.txt"

# ---- Naming ---------------------------------------------------------------
# _m0 suffix on BASE so artifacts don't collide with the baseline run.
BASE="yeast235_chrII_100kb_normalized_m0"

# ---- Pipeline parameters --------------------------------------------------
# Identical to the baseline — we want to isolate the effect of -m 0 alone.
KMER=31
MEM_LEN=30
MIN_OCC=1
THREADS=16
VALIDATE_SAMPLE=2000

# ---- Reference run for compare.sh -----------------------------------------
# Leave empty: the baseline (-m 1024) and -m 0 runs have entirely different
# node IDs, so byte-level compare against the baseline is meaningless. Once
# this -m 0 run is validated, capture it as its own reference.
REF_DIR=""
REF_BASE=""
