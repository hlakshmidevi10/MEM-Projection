# =============================================================================
# Config: HPRC v1 chr6 — alt-reads query
# =============================================================================
# Query config for running find_mems + gafpack against the hprc-chr6 index
# using alt haplotype reads (HG00438#2#JAHBCA010000010.1#0).
#
# Usage:
#   ./query.sh hprcv1-chr6-alt-reads.env hprc-chr6-2026-06-02 [--gaf]
# =============================================================================

# ---- Inputs ---------------------------------------------------------------
# GBZ not needed at query time — the index is already built.
# Included for reference/provenance only.
GBZ="$MEM_PROJ/hprcv1/chr6.gbz"

# Reads file: 100K reads from HG00438#2#JAHBCA010000010.1#0 (alt haplotype)
# Noisy reads (with sequencing errors), 200bp
READS="$MEM_PROJ/hprcv1/chr6.alt_noisy.reads.txt"

# ---- Naming ---------------------------------------------------------------
# BASE must match the index files in runs/hprc-chr6-2026-06-02/
BASE="hprcv1_chr6"

# ---- Pipeline parameters --------------------------------------------------
# MEM_LEN  — find_mems minimum MEM length
# MIN_OCC  — minimum MEM occurrence count to report (1 keeps everything)
# VALIDATE_SAMPLE — random sample size for validate_gaf_v2.py (with --gaf)
MEM_LEN=50
MIN_OCC=1
VALIDATE_SAMPLE=2000

# ---- Not used at query time (included for completeness) -------------------
KMER=31
THREADS=16

# ---- Reference run for compare.sh (optional) ------------------------------
REF_DIR=""
REF_BASE=""
