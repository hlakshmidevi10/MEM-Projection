# =============================================================================
# Config: HPRC v1 chr1 — HG00097 noisy reads query (L=25)
# =============================================================================
# Query config for running find_mems + gafpack against the hprcv1-chr1 index
# using noisy reads from HG00097 haplotype.
#
# Usage:
#   ./query.sh hprcv1-chr1-hg00097-noisy-L25.env hprcv1-chr1-2026-08-12 [query-name] [--gaf]
# =============================================================================

# ---- Inputs ---------------------------------------------------------------
GBZ="$HOME/mem-projection/hprcv1-chr1/chr1.gbz"

# Reads file: 100K noisy reads from HG00097, 200bp
READS="$HOME/mem-projection/hprcv1/chr1.hg00097_noisy.reads.txt"

# ---- Naming ---------------------------------------------------------------
BASE="hprcv1_chr1"

# ---- Pipeline parameters --------------------------------------------------
MEM_LEN=25
MIN_OCC=1
VALIDATE_SAMPLE=2000

# ---- Not used at query time -----------------------------------------------
KMER=31
THREADS=64

# ---- Reference run for compare.sh (optional) ------------------------------
REF_DIR=""
REF_BASE=""
