# HPRC v1 chr6 — HG002 clean reads query with MEM_LEN=25
# HG002 is NOT in HPRC v1 graph (sourced from HPRCv2) — tests out-of-graph reads
# Clean reads: wgsim -e 0 -r 0 (no sequencing errors)

GBZ="$MEM_PROJ/hprcv1/chr6.gbz"
READS="$MEM_PROJ/hprcv1/chr6.hg002_clean.reads.txt"
BASE="hprcv1_chr6"

MEM_LEN=25
MIN_OCC=1
VALIDATE_SAMPLE=2000

KMER=31
THREADS=16
