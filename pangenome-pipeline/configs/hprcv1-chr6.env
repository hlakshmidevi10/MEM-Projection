# =============================================================================
# Config: HPRC v1 chr6
# =============================================================================
# Rename to hprcv1-chr6.env before invoking run.sh:
#   mv hprcv1-chr6.env.example hprcv1-chr6.env
#   cd ../.. && ./pangenome-pipeline/run.sh hprcv1-chr6.env hprcv1-chr6-<date>
#
# All paths resolved relative to $MEM_PROJ (set by run.sh = mem-projection/).
# =============================================================================

# ---- Inputs ---------------------------------------------------------------
# Only $GBZ is an input. run.sh derives ${BASE}.gfa from $GBZ in step 01b
# via `vg convert -fW --no-translation`, so the GFA gafpack walks is
# guaranteed to share node IDs with what find_mems sees.
# Do NOT set GFA here — run.sh will warn and ignore it.
GBZ="$MEM_PROJ/hprcv1/chr6.gbz"

# Reads file: one query sequence per line (no FASTA headers, no quality).
# Convert a FASTQ with:   awk 'NR%4==2' reads.fq > reads.txt
# Convert a FASTA with:   awk '/^>/{next}{print}' reads.fa > reads.txt
# TODO: set this before running. Pipeline will fail at the "Input check"
# step until this file exists.
READS="$MEM_PROJ/hprcv1/chr6.reads.txt"

# ---- Naming ---------------------------------------------------------------
# BASE prefixes index artifacts: .seq .rl_bwt .ri .tags _compressed.tags .paths
# OUT  prefixes query outputs:   _path_pos_v2.bin _seq_id_starts.out .gaf _coverage.csv
BASE="hprcv1_chr6"
OUT="hprcv1_chr6_reads"

# ---- Pipeline parameters --------------------------------------------------
# KMER     — build_tags kmer size. 31 is the established yeast/HPRC default.
# MEM_LEN  — find_mems minimum MEM length. Critical scale knob:
#              yeast (small graph):  30
#              HPRC chr6 (~90 haps): 50–80 recommended for first run.
#              Drop to 30 only once you've sized the output and have RAM.
# MIN_OCC  — minimum MEM occurrence count to report. 1 keeps everything.
# THREADS  — used by gbz_extract and grlbwt-cli. Set to your physical cores.
# VALIDATE_SAMPLE — random sample size for validate_gaf_v2.py.
KMER=31
MEM_LEN=50
MIN_OCC=1
THREADS=16
VALIDATE_SAMPLE=2000

# ---- Reference run for compare.sh (optional) ------------------------------
# Leave empty: this is the first HPRC chr6 run, no prior reference exists.
# After a known-good run, point this at runs/<that-tag>/ and re-run compare.sh
# to set-equality-check the .gaf and _coverage.csv outputs.
REF_DIR=""
REF_BASE=""
REF_OUT=""
