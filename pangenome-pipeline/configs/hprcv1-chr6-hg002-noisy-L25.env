# =============================================================================
# Config: HPRC v1 chr6 — HG002 noisy reads L25 (held-out sample from v2)
# =============================================================================
# HG002 is in HPRCv2 but NOT in HPRCv1, so these reads test alignment
# against a novel haplotype not embedded in the pangenome graph.
#
# Usage:
#   ./query.sh configs/hprcv1-chr6-hg002-noisy-L25.env hprc-chr6-2026-06-02 [--gaf]
# =============================================================================

# ---- Inputs ---------------------------------------------------------------
GBZ="$MEM_PROJ/hprcv1/chr6.gbz"

# Reads file: 100K reads from HG002#1#chr6#0 (v2-only sample)
# Noisy reads (with sequencing errors), 200bp
READS="$MEM_PROJ/hprcv1/chr6.hg002_noisy.reads.txt"

# ---- Naming ---------------------------------------------------------------
BASE="hprcv1_chr6"

# ---- Pipeline parameters --------------------------------------------------
MEM_LEN=25
MIN_OCC=1
VALIDATE_SAMPLE=2000

# ---- Not used at query time -----------------------------------------------
KMER=31
THREADS=16
REF_DIR=""
REF_BASE=""
